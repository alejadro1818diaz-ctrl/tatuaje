<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:text="¿Qué tipo de tatuaje te gusta más?"
        android:textSize="22sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbBrazoEntero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Brazo entero"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rbEspalda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Espalda"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rbMano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Mano"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rbCuello"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cuello"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rbAntebrazo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Antebrazo"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rbPecho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Pecho"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rbNinguno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Ninguno"
            android:textSize="18sp" />

    </RadioGroup>

</LinearLayout>